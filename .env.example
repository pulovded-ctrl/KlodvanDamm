# Copy to .env and fill in. NEVER commit .env.
# Bybit API key: trade-only permissions, withdrawals DISABLED, IP whitelist ON.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram alerts (phase 1). Create a bot via @BotFather, get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading is OFF unless this is exactly "true" AND you pass --live AND type the confirmation phrase.
LIVE_TRADING=false
